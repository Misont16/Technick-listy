# PostgreSQL databaze. Pro lokalni vyvoj muzes pouzit lokalni Postgres,
# pro nasazeni napr. Neon (https://neon.tech) nebo Vercel Postgres.
DATABASE_URL="postgresql://uzivatel:heslo@host:5432/nazev_db"

# Vygeneruj napr. pomoci: openssl rand -base64 32
AUTH_SECRET="zmen-me-na-nahodny-retezec"

# Verejny produktovy feed eshopu (Google Merchant XML), pouziva se pro
# tlacitko "Synchronizovat z eobaly.cz" na strance /products/import
EOBALY_FEED_URL="https://www.eobaly.cz/google_1457.xml"
